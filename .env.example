# Demo не обращается в сеть. ChatGPT Plus не оплачивает OpenAI API.
AIAC_LLM_MODE=demo
# Для реального режима: AIAC_LLM_MODE=live.
# Поддерживаемые провайдеры: openai (OpenAI). Другие пока не подключены.
AIAC_LLM_PROVIDER=openai
AIAC_LLM_MODEL=gpt-6-luna
# Ключ относится только к выбранному провайдеру. Сейчас реализован только openai.
OPENAI_API_KEY=
